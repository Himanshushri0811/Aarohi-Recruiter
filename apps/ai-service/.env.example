# ==============================================================================
# Aarohi AI Recruiter Service - Environment Configuration Template
# ==============================================================================
# Copy this file to .env for local development:
#   cp .env.example .env
#
# NOTE: In staging and production environments, inject these variables via secure
# secret managers (e.g. AWS Secrets Manager, HashiCorp Vault, or GCP Secret Manager).
# ==============================================================================

# ------------------------------------------------------------------------------
# Application Core Settings
# ------------------------------------------------------------------------------
APP_ENV=development
# Render production must set APP_ENV=production and DEBUG=false.
APP_NAME=aarohi-ai-service
DEBUG=true
API_V1_PREFIX=/api/v1
HOST=0.0.0.0
PORT=8000
# Browser traffic must use the Node API; this service has no browser CORS allowlist.

# ------------------------------------------------------------------------------
# Security & Tenant Isolation
# ------------------------------------------------------------------------------
# Must exactly match AI_SERVICE_SECRET in apps/api/.env. Use the same randomly
# generated value of at least 32 characters in both services.
# Node.js issues HS256 tokens with issuer aarohi-api and audience aarohi-ai-service.
SECRET_KEY=change_this_to_a_secure_random_32_plus_character_string_for_dev_mode
ALGORITHM=HS256
SERVICE_TOKEN_TTL_SECONDS=3600
# Optional comma-separated list of allowed organization IDs (leave empty to allow all authorized tenants)
ALLOWED_ORGANIZATION_IDS=[]

# ------------------------------------------------------------------------------
# Logging & Observability
# ------------------------------------------------------------------------------
LOG_LEVEL=INFO
LOG_FORMAT=json
ENABLE_SENSITIVE_DATA_MASKING=true

# ------------------------------------------------------------------------------
# LLM Provider Configuration
# Supported: gemini, openai, mock
# Production must select gemini or openai and provide that provider's key.
# ------------------------------------------------------------------------------
LLM__PROVIDER=mock
LLM__MODEL=gemini-2.0-flash
LLM__TEMPERATURE=0.3
LLM__MAX_TOKENS=1024
LLM__REQUEST_TIMEOUT_SECONDS=30.0
# Set for Google Gemini
LLM__GEMINI_API_KEY=
# Set for OpenAI (fallback or secondary)
LLM__OPENAI_API_KEY=

# ------------------------------------------------------------------------------
# Speech-To-Text (STT) Provider Configuration
# Supported: groq, deepgram, mock
# Production must select groq or deepgram and provide that provider's key.
# ------------------------------------------------------------------------------
STT__PROVIDER=mock
STT__MODEL=nova-2
STT__LANGUAGE=en-IN
STT__PUNCTUATE=true
STT__INTERIM_RESULTS=true
# Set for Deepgram
STT__DEEPGRAM_API_KEY=
# Set for Groq
STT__GROQ_API_KEY=

# ------------------------------------------------------------------------------
# Text-To-Speech (TTS) Provider Configuration
# Implemented providers: gemini_tts, mock
# Production must select a non-mock provider and provide its API key.
# Legacy Cartesia settings are retained below for configuration compatibility.
# ------------------------------------------------------------------------------
TTS__PROVIDER=mock
TTS__VOICE_ID=aarohi-indian-female-neutral
TTS__SPEED=1.0
TTS__MODEL=sonic-multilingual
# For Gemini TTS, set TTS__PROVIDER=gemini_tts, then use:
# TTS__MODEL=gemini-3.8-flash-tts
# TTS__VOICE_ID=Aoede
TTS__GEMINI_API_KEY=
# Set for Cartesia
TTS__CARTESIA_API_KEY=

# ------------------------------------------------------------------------------
# Realtime LiveKit WebRTC Configuration
# ------------------------------------------------------------------------------
LIVEKIT__URL=wss://livekit.example.com
LIVEKIT__API_KEY=
LIVEKIT__API_SECRET=
LIVEKIT__AGENT_NAME=aarohi-interviewer
LIVEKIT__PING_TIMEOUT_SECONDS=15.0

# ------------------------------------------------------------------------------
# Redis Transient State & Coordination
# ------------------------------------------------------------------------------
REDIS__HOST=localhost
REDIS__PORT=6379
REDIS__PASSWORD=
REDIS__DB=0
REDIS__SSL=false
REDIS__TIMEOUT_SECONDS=5.0

# ------------------------------------------------------------------------------
# Cost Budgeting & Safety Limits
# ------------------------------------------------------------------------------
BUDGET__MAX_INTERVIEW_DURATION_MINUTES=45
BUDGET__MAX_TOKENS_PER_INTERVIEW=15000
BUDGET__MAX_AUDIO_MINUTES_PER_INTERVIEW=50
BUDGET__MAX_CONCURRENT_INTERVIEWS=20
BUDGET__COST_ALERT_THRESHOLD_USD=5.0
