# ============================================================
# AI Recruiter — API Environment Configuration
# ============================================================
# Copy this file to .env and fill in real values.
# Never commit .env to version control.

# ---------------------------
# Application
# ---------------------------
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# ---------------------------
# Interview AI service (service-to-service authentication)
# ---------------------------
# Render production URL: https://aarohi-recruiter-1.onrender.com
AI_SERVICE_URL=http://localhost:8000
# Must be the same secret configured as SECRET_KEY in apps/ai-service/.env.
# Use a cryptographically random value of at least 32 characters.
# Internal JWTs use HS256, issuer aarohi-api, and audience aarohi-ai-service.
AI_SERVICE_SECRET=change_this_to_the_same_secure_secret_as_ai_service_SECRET_KEY

# ---------------------------
# Database (PostgreSQL)
# ---------------------------
DATABASE_URL=postgresql://airecruiter:password@localhost:5432/airecruiter_dev

# ---------------------------
# CORS
# ---------------------------
# Comma-separated list of allowed origins
# Keep localhost for development. Render production must set exactly:
# CORS_ORIGINS=https://aarohi-recruiter-camd.vercel.app
CORS_ORIGINS=http://localhost:3000

# ---------------------------
# Logging
# ---------------------------
LOG_LEVEL=info

# ---------------------------
# JWT Secrets (minimum 32 characters each)
# ---------------------------
# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change_this_to_a_secure_random_access_secret_min_32_chars
JWT_REFRESH_SECRET=change_this_to_a_different_secure_random_secret_min_32_chars

# ---------------------------
# Cookies
# ---------------------------
COOKIE_DOMAIN=
# Leave COOKIE_DOMAIN empty for the Render API host. Production requires HTTPS
# and cross-site refresh cookies: set COOKIE_SECURE=true.
COOKIE_SECURE=false

# ---------------------------
# Rate Limiting
# ---------------------------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
